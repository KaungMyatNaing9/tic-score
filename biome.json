{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "scripts/**/*.ts",
      "package.json",
      "tsconfig.json",
      "tsconfig.test.json"
    ],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": ["src/baseline/table.ts"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
